+    /// ⚡ Bolt Optimization: Iterator-based intersection of metadata indices.
+    fn intersect_metadata_indices_iter<'a>(
+        a: impl Iterator<Item = TimelineVersionMetadataIndex> + 'a,
+        b: &'a IndexVec,
+    ) -> Box<dyn Iterator<Item = TimelineVersionMetadataIndex> + 'a> {
+        const HASH_THRESHOLD: usize = 16;
+        if b.len() < HASH_THRESHOLD {
+            Box::new(a.filter(move |v| b.contains(v)))
+        } else {
+            use std::collections::HashSet;
+            let b_set: std::collections::HashSet<_> = b.iter().copied().collect();
+            Box::new(a.filter(move |v| b_set.contains(v)))
+        }
     }

