     #[test]
     fn test_id_generator_ensure_at_least_exact_boundary() {
         // Target mutant: replace `>` with `>=` in IdGenerator::ensure_at_least
-        let gen = IdGenerator::with_start(100);
+        let generator = IdGenerator::with_start(100);
         // Should not update if given exactly the current next_id - 1
-        gen.ensure_at_least(99);
-        assert_eq!(gen.current(), 100);
+        generator.ensure_at_least(99);
+        assert_eq!(generator.current(), 100);
     }

     #[test]
     fn test_id_generator_next_exact_boundary() {
